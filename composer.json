{
    "name": "flownative/oauth2-server",
    "license": "MIT",
    "type": "neos-package",
    "description": "An OAuth 2.1 authorization server for Flow Framework applications, built on league/oauth2-server",
    "authors": [
        {
            "name": "Robert Lemke",
            "email": "robert@flownative.com",
            "homepage": "https://www.flownative.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@flownative.com"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/robertlemke"
        }
    ],
    "require": {
        "php": "8.4.* || 8.5.*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "neos/flow": "^9.0",
        "doctrine/dbal": "^3.0 || ^4.0",
        "guzzlehttp/psr7": "^2.6",
        "league/oauth2-server": "^9.4",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/http-client": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/yaml": "^5.1 || ^6.0 || ^7.0"
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Flownative\\OAuth2\\Server\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flownative\\OAuth2\\Server\\Tests\\": "Tests"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Flownative.OAuth2.Server"
        }
    }
}
